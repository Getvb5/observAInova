DATABASE_URL=postgresql+psycopg://pci:pci@localhost:5432/pci
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=pci-objects
OBJECT_STORAGE_ACCESS_KEY=pci
OBJECT_STORAGE_SECRET_KEY=replace-me
APP_ENV=development
AUTH_MODE=local
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_ISSUER=observainova-local
OIDC_ISSUER=https://identity.example/realms/observainova
OIDC_AUDIENCE=observainova-api
OIDC_JWKS_URL=https://identity.example/realms/observainova/.well-known/jwks.json
OIDC_ALGORITHMS=["RS256"]
OIDC_ROLES_CLAIM=roles
OIDC_ROLE_MAP={"observainova-curator":"curator","observainova-supervisor":"supervisor","observainova-admin":"admin"}
CLAIMS_PROVIDER=deterministic
CLAIMS_ENDPOINT_URL=https://model-provider.example/extract
CLAIMS_API_KEY=replace-me
CLAIMS_MODEL=replace-me
CLAIMS_TIMEOUT=30
CLAIMS_SCHEMA_VERSION=v1
CLAIMS_INSTRUCTION_VERSION=v1
DOCUMENT_HOST_ALLOWLIST=repositorio.ufpe.br
DOCUMENT_MAX_BYTES=104857600
DOCUMENT_TIMEOUT_SECONDS=30
PUBLICATION_RELAY_INTERVAL_SECONDS=5
PUBLICATION_LEASE_SECONDS=300
